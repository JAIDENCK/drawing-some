<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/chrome"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <Button android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back" />
            <Button android:id="@+id/pen" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pen" />
            <Button android:id="@+id/eraser" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Eraser" />

            <TextView
                android:id="@+id/sizeLabel"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/size"
                android:layout_width="160dp"
                android:layout_height="wrap_content"
                android:max="79" />

            <LinearLayout
                android:id="@+id/swatches"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />

            <Button android:id="@+id/undo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Undo" />
            <Button android:id="@+id/redo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Redo" />
            <Button android:id="@+id/guide" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/fit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fit" />
            <Button android:id="@+id/clear" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Clear" />
            <Button android:id="@+id/save" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save PNG" />
        </LinearLayout>
    </HorizontalScrollView>

    <View style="@style/Gridline.Divider" />

    <com.gridline.app.sketch.SketchView
        android:id="@+id/sketchView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
