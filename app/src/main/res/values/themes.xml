<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Gridline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/chrome</item>
        <item name="android:colorPrimary">@color/chrome</item>
        <item name="android:colorPrimaryDark">@color/chrome</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/chrome</item>
        <item name="android:navigationBarColor">@color/chrome</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:buttonStyle">@style/Gridline.Button</item>
    </style>

    <style name="Gridline.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <style name="Gridline.Bar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@color/chrome</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>

    <style name="Gridline.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
